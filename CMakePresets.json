{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio (MSVC) with CUDA 13.4",
      "description": "build/msvc with the solution; CUDA 13.4 by its folder, whatever CUDA_PATH and the PATH say; the programs land in bin/msvc",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "cuda=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "FAMILY_BIN_DIR": "${sourceDir}/bin/msvc",
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    },
    {
      "name": "release",
      "inherits": "msvc",
      "displayName": "Release (MSVC, static runtime, what ships)",
      "description": "build/release for every GeForce RTX (20: sm_75, 30: sm_86, 40: sm_89, 50: sm_120, and PTX for what comes after); Deploy/build_release.ps1 stages, zips and packs it into dist/",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "75-real;86-real;89-real;120",
        "FAMILY_BIN_DIR": "",
        "ADDITIV_STATIC_RUNTIME": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
