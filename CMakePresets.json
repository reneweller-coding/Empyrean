{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio (MSVC) with CUDA 13.4",
      "description": "build/msvc with the solution; CUDA 13.4 by its folder, whatever CUDA_PATH and the PATH say; the programs land in bin/msvc",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "cuda=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.4",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "FAMILY_BIN_DIR": "${sourceDir}/bin/msvc",
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
